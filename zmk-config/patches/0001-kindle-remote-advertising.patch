diff --git a/app/Kconfig b/app/Kconfig
index fcfdfcbd..4451a34d 100644
--- a/app/Kconfig
+++ b/app/Kconfig
@@ -245,9 +245,21 @@ config BT_PERIPHERAL_PREF_LATENCY
 config BT_PERIPHERAL_PREF_TIMEOUT
     default 400
 
+config ZMK_BLE_KINDLE_REMOTE_ADV
+    bool "Advertise as an Amazon Kindle Remote"
+    help
+      Adds manufacturer data 71 01 04 43 to the advertising packet and moves
+      the device name to the scan response.
+
+config ZMK_BLE_KINDLE_FAST_ADV_SECONDS
+    int "Seconds of fast advertising before switching to slow (1-1.2 s) advertising"
+    default 30
+    depends on ZMK_BLE_KINDLE_REMOTE_ADV
+
 # The device name should be 16 characters or less so it fits within the
 # advertising data.
 config BT_DEVICE_NAME_MAX
+    default 21 if ZMK_BLE_KINDLE_REMOTE_ADV
     default 16
 
 endif # ZMK_BLE
